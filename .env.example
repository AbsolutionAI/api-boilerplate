# Server
PORT=4000

# Auth — change this to a long random string before production
JWT_SECRET=change-me-to-a-long-random-string

# Database (SQLite by default — works out of the box)
DATABASE_URL=file:./dev.db

# Optional: switch to Postgres by changing prisma/schema.prisma provider
# and setting something like:
# DATABASE_URL=postgresql://user:password@localhost:5432/api_boilerplate

# Rate limiting (requests per window)
RATE_LIMIT_MAX=100
